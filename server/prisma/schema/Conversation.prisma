enum ConversationType{
    PRIVATE
    GROUP 

    @@map("conversation_type")
}

model Conversation {
  id String           @id @default(cuid()) @map("conversation_id")
  type           ConversationType @default(PRIVATE)
  title          String?          @db.VarChar(255) // Optional, only for groups

  workspaceId   String           @map("workspace_id")
  workspace     Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  
  // Relationship :Creater
  createdById    String           @map("created_by_id") // Links to users.userId
  createdBy      User             @relation("CreatedConversations", fields: [createdById], references: [id])

  createdAt      DateTime         @default(now()) @db.Timestamptz(3) @map("created_at")
  updatedAt      DateTime         @updatedAt @db.Timestamptz(3) @map("updated_at")
  
  // Relationships: Participants & Messages
  participants   Participant[] 
  messages       Message[]
  actionItems    ActionItem[]
  decisions      Decision[]
  summaries      ConversationSummary[]

  @@map("conversations")
}