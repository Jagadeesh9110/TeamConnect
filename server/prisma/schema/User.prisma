model User {
  id      String    @id @default(cuid()) @map("user_id")
  fullName    String    @db.VarChar(255) @map("full_name")
  email       String    @unique @db.VarChar(255)
  password     String    @db.VarChar(255) @map("password")
  
  refreshTokenHash String? @map("refresh_token_hash")
  tokenVersion Int @default(0) @map("token_version")

  isEmailVerified         Boolean   @default(false) @map("is_email_verified")
  emailVerificationToken  String?   @unique @map("email_verification_token")
  emailVerificationExpiry DateTime? @db.Timestamptz(3) @map("email_verification_expiry")

  displayName String?   @db.VarChar(100) @map("display_name")
  phoneNumber String?   @unique @db.VarChar(20) @map("phone_number")
  isOnline    Boolean   @default(false) @map("is_online")
  lastSeenAt  DateTime? @default(now()) @db.Timestamptz(3) @map("last_seen_at")
  createdAt   DateTime  @default(now()) @db.Timestamptz(3) @map("created_at")
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3) @map("updated_at")

  //Relationships
  createdConversations Conversation[] @relation("CreatedConversations")
  participants         Participant[] 
  messages             Message[]

  createdWorkspaces    Workspace[] @relation("CreatedWorkspaces")
  workspaceMemberships WorkspaceMember[]

  @@map("users") // This renames the table from 'User' to 'users' in Postgres
}
